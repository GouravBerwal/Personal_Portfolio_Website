# ==============================================================
# Django Environment Configuration (Production Template)
# ==============================================================
# Copy this file to .env and replace with your production values:
# cp .env.example .env

# Secret Key for cryptographic signing (Generate a random 50+ character string)
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-for-production

# Debug Mode: True for development, False for production
DJANGO_DEBUG=False

# Allowed Hostnames / Domains (Comma-separated)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com
